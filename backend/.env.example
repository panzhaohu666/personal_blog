# 环境变量配置模板 - 复制为 .env 并填入真实值
# cp .env.example .env

# ── 应用 ────────────────────────────────────────────────
APP_NAME=个人博客 API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── 服务器 ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── 数据库 (PostgreSQL) ─────────────────────────────────
# 格式: postgresql+asyncpg://用户:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_web
DATABASE_IS_SQLITE=false

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# ── JWT 认证密钥 ────────────────────────────────────────
# 生产环境务必使用强随机密钥！生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS 允许域名（逗号分隔） ───────────────────────────
# 格式: ["http://localhost:5173","https://example.com"]
CORS_ORIGINS=["http://localhost:5173"]

# ── Elasticsearch ───────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=personal_web

# ── 文件上传 ────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── RSS ─────────────────────────────────────────────────
SITE_TITLE=个人博客
SITE_DESCRIPTION=一个个人技术博客
SITE_URL=http://localhost:5173
