# ============================================================
# 个人博客 — 环境变量配置
# 复制此文件为 .env 并修改实际值
# cp .env.example .env
# ============================================================

# --- 后端配置 (FastAPI) ---
# 数据库连接 (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://blog:blog_dev_password@localhost:5432/blog
# Redis 连接（访问统计计数器）
REDIS_URL=redis://localhost:6379/0
# JWT 密钥 — 生产环境必须修改为随机字符串
SECRET_KEY=change-me-to-a-random-string-in-production
# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173
# 调试模式 (true/false)
DEBUG=true
# 媒体文件上传目录（相对于 backend/）
MEDIA_DIR=../media
# JWT 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- 前端配置 (React + Vite) ---
# API 后端地址
VITE_API_BASE_URL=http://localhost:8000

# --- 生产环境额外配置 ---
# ALLOWED_HOSTS=your-domain.com
# ELASTICSEARCH_URL=http://elasticsearch:9200
